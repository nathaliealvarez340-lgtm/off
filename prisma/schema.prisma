generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

enum Role {
  ADMIN
  USER
}

enum CommentStatus {
  PUBLISHED
  PENDING
}

enum LoungeContentType {
  LIBRARY
  SIGNAL
  RESOURCE
  NATHALIE_NOTE
  EARLY_ACCESS
}

enum GalleryCategory {
  EXPLORE
  CONFESSIONS
  PEOPLE
  START_HERE
  TWENTIES
}

enum GalleryMediaType {
  IMAGE
  VIDEO
}

enum GalleryMusicSource {
  UPLOAD
  SPOTIFY
}

enum GalleryShareType {
  INTERNAL
  EXTERNAL
  COPY_LINK
}

enum ConnectionStatus {
  PENDING
  CONNECTED
  DECLINED
}

enum OffIrlEventStatus {
  DRAFT
  PUBLISHED
  CANCELLED
  COMPLETED
}

enum OffIrlRsvpStatus {
  GOING
  WAITLIST
  CANCELLED
}

model Article {
  id               String                   @id @default(cuid())
  title            String
  slug             String                   @unique
  excerpt          String
  content          String
  coverImage       String
  category         String
  keywords         String[]                 @default([])
  themes           String[]                 @default([])
  author           String                   @default("Nathalie Garcia")
  readTime         String
  publishedAt      DateTime?
  status           String                   @default("draft")
  featured         Boolean                  @default(false)
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt
  comments         Comment[]
  topicSuggestions TopicSuggestion[]
  completions      ArticleCompletion[]
  readingProgress  ArticleReadingProgress[]
  highlights       ArticleHighlight[]
  conversationRefs EditorialConversation[]
}

model LoungeContent {
  id             String            @id @default(cuid())
  type           LoungeContentType
  title          String
  number         String?
  description    String?
  content        String?
  keywords       String[]          @default([])
  links          Json?
  relatedArticle String?
  releaseDate    DateTime?
  statusLabel    String?
  status         String            @default("draft")
  publishedAt    DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([type, status])
  @@index([publishedAt])
}

model GalleryPost {
  id             String               @id @default(cuid())
  mediaType      GalleryMediaType
  mediaUrl       String
  thumbnailUrl   String?
  title          String?
  caption        String?
  altText        String?
  category       GalleryCategory
  keywords       String[]             @default([])
  mediaTransform Json?
  audioUrl       String?
  audioTitle     String?
  audioArtist    String?
  musicSource    GalleryMusicSource?
  spotifyUrl     String?
  spotifyTrackId String?
  status         String               @default("draft")
  publishedAt    DateTime?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  likes          GalleryPostLike[]
  comments       GalleryPostComment[]
  shares         GalleryPostShare[]

  @@index([category, status])
  @@index([status, publishedAt])
}

model GalleryPostLike {
  id        String      @id @default(cuid())
  postId    String
  userId    String
  createdAt DateTime    @default(now())
  post      GalleryPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([postId])
  @@index([userId])
}

model GalleryPostComment {
  id        String               @id @default(cuid())
  postId    String
  userId    String
  parentId  String?
  content   String
  status    CommentStatus        @default(PUBLISHED)
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt
  post      GalleryPost          @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent    GalleryPostComment?  @relation("GalleryCommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   GalleryPostComment[] @relation("GalleryCommentReplies")

  @@index([postId, createdAt])
  @@index([userId])
  @@index([parentId])
}

model GalleryPostShare {
  id          String           @id @default(cuid())
  postId      String
  senderId    String
  recipientId String?
  type        GalleryShareType
  createdAt   DateTime         @default(now())
  post        GalleryPost      @relation(fields: [postId], references: [id], onDelete: Cascade)
  sender      User             @relation("GallerySharesSent", fields: [senderId], references: [id], onDelete: Cascade)
  recipient   User?            @relation("GallerySharesReceived", fields: [recipientId], references: [id], onDelete: SetNull)

  @@index([postId, createdAt])
  @@index([senderId])
  @@index([recipientId])
}

model Subscriber {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  interest  String
  consent   Boolean  @default(false)
  createdAt DateTime @default(now())
}

model User {
  id                    String                           @id @default(cuid())
  name                  String
  email                 String                           @unique
  passwordHash          String
  accessCodeHash        String?
  accessCodeLookup      String?                          @unique
  role                  Role                             @default(USER)
  preferredLanguage     String                           @default("es")
  askOffPersonalContext Boolean                          @default(false)
  createdAt             DateTime                         @default(now())
  updatedAt             DateTime                         @updatedAt
  sessions              Session[]
  comments              Comment[]
  topicSuggestions      TopicSuggestion[]
  activity              MemberActivity?
  completions           ArticleCompletion[]
  readingProgress       ArticleReadingProgress[]
  memberProfile         MemberProfile?
  passwordResetTokens   PasswordResetToken[]
  notifications         Notification[]
  galleryLikes          GalleryPostLike[]
  galleryComments       GalleryPostComment[]
  gallerySharesSent     GalleryPostShare[]               @relation("GallerySharesSent")
  gallerySharesReceived GalleryPostShare[]               @relation("GallerySharesReceived")
  communityPosts        CommunityPost[]
  communityPostLikes    CommunityPostLike[]
  communityComments     CommunityComment[]
  communityCommentLikes CommunityCommentLike[]
  connectionsRequested  MemberConnection[]               @relation("ConnectionRequester")
  connectionsReceived   MemberConnection[]               @relation("ConnectionReceiver")
  achievements          MemberAchievement[]
  achievementReactions  AchievementReaction[]
  blocksCreated         MemberBlock[]                    @relation("Blocker")
  blocksReceived        MemberBlock[]                    @relation("Blocked")
  socialReports         SocialReport[]
  articleHighlights     ArticleHighlight[]
  ritualResponses       RitualResponse[]
  editorialReplies      EditorialConversationReply[]
  editorialReplyLikes   EditorialConversationReplyLike[]
  askOffConversations   AskOffConversation[]
  offIrlRsvps           OffIrlRsvp[]
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String
  title     String
  message   String
  href      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
  @@index([createdAt])
}

model ArticleReadingProgress {
  id           String   @id @default(cuid())
  userId       String
  articleId    String
  progress     Float    @default(0)
  lastPosition Int      @default(0)
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  article      Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@unique([userId, articleId])
  @@index([userId, updatedAt])
  @@index([articleId])
}

model MemberProfile {
  userId       String   @id
  memberNumber Int      @unique
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model MemberActivity {
  userId       String   @id
  totalSeconds Int      @default(0)
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ArticleCompletion {
  id          String   @id @default(cuid())
  userId      String
  articleId   String
  completedAt DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  article     Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@unique([userId, articleId])
  @@index([userId])
  @@index([articleId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  attempts  Int       @default(0)
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model AuthThrottle {
  key         String    @id
  attempts    Int       @default(0)
  lockedUntil DateTime?
  updatedAt   DateTime  @updatedAt

  @@index([updatedAt])
}

model AccessCodeRegistry {
  lookup    String   @id
  userId    String   @unique
  createdAt DateTime @default(now())
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Comment {
  id        String        @id @default(cuid())
  articleId String
  userId    String
  parentId  String?
  content   String
  status    CommentStatus @default(PUBLISHED)
  createdAt DateTime      @default(now())
  article   Article       @relation(fields: [articleId], references: [id], onDelete: Cascade)
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent    Comment?      @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   Comment[]     @relation("CommentReplies")

  @@index([articleId])
  @@index([userId])
  @@index([parentId])
}

model TopicSuggestion {
  id        String   @id @default(cuid())
  articleId String?
  userId    String
  content   String
  createdAt DateTime @default(now())
  article   Article? @relation(fields: [articleId], references: [id], onDelete: SetNull)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([articleId])
  @@index([userId])
}

model CommunityPost {
  id        String              @id @default(cuid())
  userId    String
  content   String
  imageUrl  String?
  status    String              @default("published")
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  likes     CommunityPostLike[]
  comments  CommunityComment[]

  @@index([status, createdAt])
  @@index([userId, createdAt])
}

model CommunityPostLike {
  id        String        @id @default(cuid())
  postId    String
  userId    String
  createdAt DateTime      @default(now())
  post      CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([postId])
  @@index([userId])
}

model CommunityComment {
  id        String                 @id @default(cuid())
  postId    String
  userId    String
  parentId  String?
  content   String
  status    CommentStatus          @default(PUBLISHED)
  createdAt DateTime               @default(now())
  updatedAt DateTime               @updatedAt
  post      CommunityPost          @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent    CommunityComment?      @relation("CommunityCommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   CommunityComment[]     @relation("CommunityCommentReplies")
  likes     CommunityCommentLike[]

  @@index([postId, createdAt])
  @@index([userId])
  @@index([parentId])
}

model CommunityCommentLike {
  id        String           @id @default(cuid())
  commentId String
  userId    String
  createdAt DateTime         @default(now())
  comment   CommunityComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([commentId, userId])
  @@index([commentId])
  @@index([userId])
}

model MemberConnection {
  id          String           @id @default(cuid())
  pairKey     String           @unique
  requesterId String
  receiverId  String
  status      ConnectionStatus @default(PENDING)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  requester   User             @relation("ConnectionRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  receiver    User             @relation("ConnectionReceiver", fields: [receiverId], references: [id], onDelete: Cascade)

  @@index([requesterId, status])
  @@index([receiverId, status])
}

model MemberAchievement {
  id         String                @id @default(cuid())
  key        String                @unique
  userId     String
  type       String
  title      String
  metadata   Json?
  achievedAt DateTime              @default(now())
  user       User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  reactions  AchievementReaction[]

  @@index([userId, achievedAt])
  @@index([achievedAt])
}

model AchievementReaction {
  id            String            @id @default(cuid())
  achievementId String
  userId        String
  createdAt     DateTime          @default(now())
  achievement   MemberAchievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)
  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([achievementId, userId])
  @@index([achievementId])
  @@index([userId])
}

model MemberBlock {
  id        String   @id @default(cuid())
  blockerId String
  blockedId String
  createdAt DateTime @default(now())
  blocker   User     @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked   User     @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockedId])
}

model SocialReport {
  id         String   @id @default(cuid())
  reporterId String
  targetType String
  targetId   String
  reason     String?
  status     String   @default("pending")
  createdAt  DateTime @default(now())
  reporter   User     @relation(fields: [reporterId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([targetType, targetId])
  @@index([reporterId])
}

model ArticleHighlight {
  id           String   @id @default(cuid())
  userId       String
  articleId    String
  selectedText String
  blockId      String?
  startOffset  Int?
  endOffset    Int?
  prefix       String?
  suffix       String?
  note         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  article      Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@index([userId, articleId])
  @@index([userId, updatedAt])
}

model EditorialConversation {
  id            String                       @id @default(cuid())
  internalTitle String
  question      String
  introduction  String?
  themes        String[]                     @default([])
  status        String                       @default("draft")
  publishedAt   DateTime?
  closesAt      DateTime?
  featured      Boolean                      @default(false)
  articleId     String?
  createdAt     DateTime                     @default(now())
  updatedAt     DateTime                     @updatedAt
  article       Article?                     @relation(fields: [articleId], references: [id], onDelete: SetNull)
  replies       EditorialConversationReply[]

  @@index([status, publishedAt])
  @@index([featured, publishedAt])
}

model EditorialConversationReply {
  id             String                           @id @default(cuid())
  conversationId String
  userId         String
  parentId       String?
  content        String
  status         CommentStatus                    @default(PUBLISHED)
  featured       Boolean                          @default(false)
  pinned         Boolean                          @default(false)
  createdAt      DateTime                         @default(now())
  updatedAt      DateTime                         @updatedAt
  conversation   EditorialConversation            @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User                             @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent         EditorialConversationReply?      @relation("EditorialReplyThread", fields: [parentId], references: [id], onDelete: Cascade)
  replies        EditorialConversationReply[]     @relation("EditorialReplyThread")
  likes          EditorialConversationReplyLike[]

  @@index([conversationId, createdAt])
  @@index([userId])
  @@index([parentId])
}

model EditorialConversationReplyLike {
  id        String                     @id @default(cuid())
  replyId   String
  userId    String
  createdAt DateTime                   @default(now())
  reply     EditorialConversationReply @relation(fields: [replyId], references: [id], onDelete: Cascade)
  user      User                       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([replyId, userId])
  @@index([replyId])
  @@index([userId])
}

model Ritual {
  id          String           @id @default(cuid())
  title       String
  prompt      String
  themes      String[]         @default([])
  activeFrom  DateTime
  activeUntil DateTime
  status      String           @default("draft")
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  responses   RitualResponse[]

  @@index([status, activeFrom, activeUntil])
}

model RitualResponse {
  id        String   @id @default(cuid())
  ritualId  String
  userId    String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ritual    Ritual   @relation(fields: [ritualId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([ritualId, userId])
  @@index([userId, updatedAt])
}

model AskOffConversation {
  id                 String          @id @default(cuid())
  userId             String
  title              String
  usePersonalContext Boolean         @default(false)
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  user               User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages           AskOffMessage[]

  @@index([userId, updatedAt])
}

model AskOffMessage {
  id             String             @id @default(cuid())
  conversationId String
  role           String
  content        String
  sources        Json?
  createdAt      DateTime           @default(now())
  conversation   AskOffConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

model OffIrlEvent {
  id               String            @id @default(cuid())
  title            String
  description      String
  locationName     String?
  city             String?
  country          String?
  startAt          DateTime
  endAt            DateTime
  capacity         Int?
  image            String?
  status           OffIrlEventStatus @default(DRAFT)
  registrationOpen Boolean           @default(false)
  publishedAt      DateTime?
  externalMapUrl   String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  rsvps            OffIrlRsvp[]

  @@index([status, startAt])
}

model OffIrlRsvp {
  id        String           @id @default(cuid())
  eventId   String
  userId    String
  status    OffIrlRsvpStatus @default(GOING)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  event     OffIrlEvent      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([eventId, status])
  @@index([userId])
}
