generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

enum Role {
  ADMIN
  USER
}

enum CommentStatus {
  PUBLISHED
  PENDING
}

enum LoungeContentType {
  LIBRARY
  SIGNAL
  RESOURCE
  NATHALIE_NOTE
  EARLY_ACCESS
}

enum GalleryCategory {
  EXPLORE
  CONFESSIONS
  PEOPLE
  START_HERE
  TWENTIES
}

enum GalleryMediaType {
  IMAGE
  VIDEO
}

enum GalleryShareType {
  INTERNAL
  EXTERNAL
  COPY_LINK
}

model Article {
  id               String                   @id @default(cuid())
  title            String
  slug             String                   @unique
  excerpt          String
  content          String
  coverImage       String
  category         String
  keywords         String[]                 @default([])
  author           String                   @default("Nathalie Garcia")
  readTime         String
  publishedAt      DateTime?
  status           String                   @default("draft")
  featured         Boolean                  @default(false)
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt
  comments         Comment[]
  topicSuggestions TopicSuggestion[]
  completions      ArticleCompletion[]
  readingProgress  ArticleReadingProgress[]
}

model LoungeContent {
  id             String            @id @default(cuid())
  type           LoungeContentType
  title          String
  number         String?
  description    String?
  content        String?
  keywords       String[]          @default([])
  links          Json?
  relatedArticle String?
  releaseDate    DateTime?
  statusLabel    String?
  status         String            @default("draft")
  publishedAt    DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([type, status])
  @@index([publishedAt])
}

model GalleryPost {
  id           String           @id @default(cuid())
  mediaType    GalleryMediaType
  mediaUrl     String
  thumbnailUrl String?
  title        String?
  caption      String?
  altText      String?
  category     GalleryCategory
  keywords     String[]         @default([])
  mediaTransform Json?
  audioUrl      String?
  audioTitle    String?
  audioArtist   String?
  status       String           @default("draft")
  publishedAt  DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  likes         GalleryPostLike[]
  comments      GalleryPostComment[]
  shares        GalleryPostShare[]

  @@index([category, status])
  @@index([status, publishedAt])
}

model GalleryPostLike {
  id        String      @id @default(cuid())
  postId    String
  userId    String
  createdAt DateTime    @default(now())
  post      GalleryPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([postId])
  @@index([userId])
}

model GalleryPostComment {
  id        String        @id @default(cuid())
  postId    String
  userId    String
  content   String
  status    CommentStatus @default(PUBLISHED)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  post      GalleryPost   @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([postId, createdAt])
  @@index([userId])
}

model GalleryPostShare {
  id          String           @id @default(cuid())
  postId      String
  senderId    String
  recipientId String?
  type        GalleryShareType
  createdAt   DateTime         @default(now())
  post        GalleryPost      @relation(fields: [postId], references: [id], onDelete: Cascade)
  sender      User             @relation("GallerySharesSent", fields: [senderId], references: [id], onDelete: Cascade)
  recipient   User?            @relation("GallerySharesReceived", fields: [recipientId], references: [id], onDelete: SetNull)

  @@index([postId, createdAt])
  @@index([senderId])
  @@index([recipientId])
}

model Subscriber {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  interest  String
  consent   Boolean  @default(false)
  createdAt DateTime @default(now())
}

model User {
  id                  String                   @id @default(cuid())
  name                String
  email               String                   @unique
  passwordHash        String
  accessCodeHash      String?
  accessCodeLookup    String?                  @unique
  role                Role                     @default(USER)
  preferredLanguage   String                   @default("es")
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt
  sessions            Session[]
  comments            Comment[]
  topicSuggestions    TopicSuggestion[]
  activity            MemberActivity?
  completions         ArticleCompletion[]
  readingProgress     ArticleReadingProgress[]
  memberProfile       MemberProfile?
  passwordResetTokens PasswordResetToken[]
  notifications       Notification[]
  galleryLikes        GalleryPostLike[]
  galleryComments     GalleryPostComment[]
  gallerySharesSent   GalleryPostShare[] @relation("GallerySharesSent")
  gallerySharesReceived GalleryPostShare[] @relation("GallerySharesReceived")
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String
  title     String
  message   String
  href      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
  @@index([createdAt])
}

model ArticleReadingProgress {
  id           String   @id @default(cuid())
  userId       String
  articleId    String
  progress     Float    @default(0)
  lastPosition Int      @default(0)
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  article      Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@unique([userId, articleId])
  @@index([userId, updatedAt])
  @@index([articleId])
}

model MemberProfile {
  userId       String   @id
  memberNumber Int      @unique
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model MemberActivity {
  userId       String   @id
  totalSeconds Int      @default(0)
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ArticleCompletion {
  id          String   @id @default(cuid())
  userId      String
  articleId   String
  completedAt DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  article     Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@unique([userId, articleId])
  @@index([userId])
  @@index([articleId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  attempts  Int       @default(0)
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model AuthThrottle {
  key         String    @id
  attempts    Int       @default(0)
  lockedUntil DateTime?
  updatedAt   DateTime  @updatedAt

  @@index([updatedAt])
}

model AccessCodeRegistry {
  lookup    String   @id
  userId    String   @unique
  createdAt DateTime @default(now())
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Comment {
  id        String        @id @default(cuid())
  articleId String
  userId    String
  parentId  String?
  content   String
  status    CommentStatus @default(PUBLISHED)
  createdAt DateTime      @default(now())
  article   Article       @relation(fields: [articleId], references: [id], onDelete: Cascade)
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent    Comment?      @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   Comment[]     @relation("CommentReplies")

  @@index([articleId])
  @@index([userId])
  @@index([parentId])
}

model TopicSuggestion {
  id        String   @id @default(cuid())
  articleId String?
  userId    String
  content   String
  createdAt DateTime @default(now())
  article   Article? @relation(fields: [articleId], references: [id], onDelete: SetNull)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([articleId])
  @@index([userId])
}
